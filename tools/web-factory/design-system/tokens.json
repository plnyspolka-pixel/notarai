{
  "$description": "Tokeny marki NotarAI w formacie DTCG. Źródło: strona/brand-site.css oraz docs/kampania-komputerku/pakiet/01_marki/tokens.json (zweryfikowane 2026-11-11). Zmiana wartości wymaga zgody właściciela marki.",
  "color": {
    "navy": {
      "$type": "color",
      "$value": "#071D49",
      "$description": "Nagłówki i tekst główny na jasnym tle"
    },
    "deep": {
      "$type": "color",
      "$value": "#061437",
      "$description": "Najciemniejsze tła (stopka, sekcje ciemne)"
    },
    "ink": {
      "$type": "color",
      "$value": "#0D193C"
    },
    "indigo": {
      "$type": "color",
      "$value": "#1C1CC0",
      "$description": "Początek gradientu przycisku głównego"
    },
    "blue": {
      "$type": "color",
      "$value": "#2B52D9",
      "$description": "Akcent główny, linki, obramowania aktywne"
    },
    "azure": {
      "$type": "color",
      "$value": "#2197D3"
    },
    "cyan": {
      "$type": "color",
      "$value": "#00CFFF",
      "$description": "Akcent dekoracyjny i obrys fokusu. Na białym ma kontrast 1,9:1 — nie używać do tekstu."
    },
    "link-on-white": {
      "$type": "color",
      "$value": "#0072AD",
      "$description": "Niebieski tekst na białym, kontrast 5,2:1"
    },
    "muted": {
      "$type": "color",
      "$value": "#5F6F8E",
      "$description": "Tekst pomocniczy na białym, kontrast 5,1:1. Jaśniejszych szarości nie używać do tekstu."
    },
    "bg": {
      "$type": "color",
      "$value": "#F5F7FC"
    },
    "surface": {
      "$type": "color",
      "$value": "#FFFFFF"
    },
    "stroke": {
      "$type": "color",
      "$value": "#D9E5F4"
    },
    "success": {
      "$type": "color",
      "$value": "#23764B"
    },
    "alert": {
      "$type": "color",
      "$value": "#B52E44"
    }
  },
  "gradient": {
    "primary": {
      "$type": "gradient",
      "$value": "linear-gradient(112deg,#2225AE 0%,#294DD5 66%,#247ED9 100%)",
      "$description": "Przycisk główny"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": [
        "Montserrat",
        "Segoe UI",
        "Arial",
        "sans-serif"
      ],
      "$description": "Montserrat (OFL 1.1) serwowany z własnego serwera, nigdy z zewnętrznego CDN"
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 650
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 800
      }
    }
  },
  "radius": {
    "button": {
      "$type": "dimension",
      "$value": "13px"
    },
    "card": {
      "$type": "dimension",
      "$value": "18px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "spacing": {
    "xs": {
      "$type": "dimension",
      "$value": "4px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "16px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "40px"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "72px"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Margines boczny treści; na telefonie nie mniej niż 16px"
    }
  },
  "motion": {
    "quick": {
      "$type": "duration",
      "$value": "160ms",
      "$description": "Najazd, wciśnięcie"
    },
    "normal": {
      "$type": "duration",
      "$value": "320ms",
      "$description": "Pojawianie się elementów"
    },
    "slow": {
      "$type": "duration",
      "$value": "700ms",
      "$description": "Wejście sekcji; dłuższych nie stosować"
    },
    "ease-out": {
      "$type": "cubicBezier",
      "$value": [
        0.16,
        1,
        0.3,
        1
      ]
    }
  },
  "shadow": {
    "card": {
      "$type": "shadow",
      "$value": "0 32px 70px -35px rgba(10,40,91,.28)"
    }
  }
}
