{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "description": "Initial neutral, high-contrast design tokens. References—not existing product branding.",
  "color": {
    "canvas": {
      "$type": "color",
      "$value": "#0B1220"
    },
    "surface": {
      "$type": "color",
      "$value": "#142238"
    },
    "text": {
      "$type": "color",
      "$value": "#F1F5F9"
    },
    "muted": {
      "$type": "color",
      "$value": "#B4C4D7"
    },
    "accent": {
      "$type": "color",
      "$value": "#67E8F9"
    },
    "focus": {
      "$type": "color",
      "$value": "#FACC15"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "6px"
    },
    "md": {
      "$type": "dimension",
      "$value": "12px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "18px"
    }
  },
  "spacing": {
    "xs": {
      "$type": "dimension",
      "$value": "4px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "16px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "32px"
    }
  },
  "motion": {
    "quick": {
      "$type": "duration",
      "$value": "120ms"
    },
    "normal": {
      "$type": "duration",
      "$value": "240ms"
    }
  }
}
