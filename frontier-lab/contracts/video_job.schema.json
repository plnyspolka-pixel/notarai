{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VideoAgentJob",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "tenant_id",
    "project",
    "model",
    "workflow_version",
    "scenes",
    "budget_usd"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "workflow_version": {
      "type": "string",
      "minLength": 1
    },
    "budget_usd": {
      "type": "number",
      "minimum": 0
    },
    "language": {
      "type": "string",
      "default": "pl"
    },
    "target_aspect_ratio": {
      "enum": [
        "9:16",
        "16:9",
        "1:1"
      ]
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "character_id",
          "voice_id",
          "description"
        ],
        "properties": {
          "character_id": {
            "type": "string"
          },
          "voice_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "reference_uri": {
            "type": "string"
          },
          "rights_verified": {
            "type": "boolean"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_id",
          "shots"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "shot_id",
                "prompt",
                "duration_seconds"
              ],
              "properties": {
                "shot_id": {
                  "type": "string"
                },
                "character_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "prompt": {
                  "type": "string"
                },
                "duration_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 30
                },
                "seed": {
                  "type": "integer",
                  "minimum": 0
                },
                "reference_frame_uri": {
                  "type": "string"
                },
                "dialogue_text": {
                  "type": "string"
                },
                "voice_id": {
                  "type": "string"
                },
                "lora_ref": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
