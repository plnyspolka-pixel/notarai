  "napisy": [
   {
    "od": 0.0,
    "do": 4.75,
    "tekst": "Czterdzieści minut spóźnienia. A o szesnastej wyłączają księgi."
   },
   {
    "od": 4.67,
    "do": 8.88,
    "tekst": "Pan sprzedający jest już na schodach. Prosi, żeby czytać szybciej."
   },
   {
    "od": 8.78,
    "do": 11.18,
    "tekst": "Czterdzieści minut"
   },
   {
    "od": 14.17,
    "do": 19.08,
    "tekst": "Sprzedaż w rodzinie, przed upływem pięciu lat. Będzie rozmowa o podatku."
   },
   {
    "od": 19.0,
    "do": 23.83,
    "tekst": "Odpis z księgi pobiorę teraz. Od szesnastej do osiemnastej system ma przerwę."
   },
   {
    "od": 28.75,
    "do": 34.16,
    "tekst": "W projekcie lokal dwanaście. W księdze dwadzieścia jeden."
   },
   {
    "od": 34.06,
    "do": 37.38,
    "tekst": "Poprawię w sekretariacie i wydrukuję tę jedną stronę."
   },
   {
    "od": 37.29,
    "do": 42.62,
    "tekst": "Pani rejent, Adrian Sowa. W sprawie pani Nowak: może jednak pierwszy grudnia?"
   },
   {
    "od": 43.27,
    "do": 47.24,
    "tekst": "Termin ustalają strony, panie Adrianie. Nie pośrednik."
   },
   {
    "od": 47.14,
    "do": 51.82,
    "tekst": "Klient prosi, żeby poprawionego już nie czytać. Bardzo się spieszy."
   },
   {
    "od": 51.69,
    "do": 58.22,
    "tekst": "Przeczytam cały paragraf jeszcze raz. I powiem mu o podatku. Księgę mamy sprzed szesnastej."
   },
   {
    "od": 58.12,
    "do": 65.04,
    "tekst": "Pani rejent, dzwoniła pani Irena Nowak. Prosi o rozmowę jutro. Bez syna."
   }
  ],
