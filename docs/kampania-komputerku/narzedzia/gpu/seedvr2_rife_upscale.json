{
 "_opis": "Workflow API ComfyUI: wideo 480x832@16 -> SeedVR2 3B (super-rozdzielczosc, krotszy bok 1080) -> RIFE 4.7 x2 (klatki posrednie) -> mp4. Kolejnosc jak w DLSS: najpierw upscale, potem generowanie klatek (RIFE na 16 kl./s wejscia = polowa pracy SeedVR2). Wezly: ComfyUI-VideoHelperSuite, ComfyUI-SeedVR2_VideoUpscaler (numz, v2.5+), ComfyUI-Frame-Interpolation. NIEPRZETESTOWANE na GPU: nazwy wejsc wezlow SeedVR2 sprawdz w ComfyUI (prawy klik na wezle -> Properties) przy pierwszym uruchomieniu. batch_size 4n+1: wieksza = lepsza spojnosc w czasie, ale wiecej VRAM; 21 na 24 GB przy 1080p, przy OOM zejdz do 13 albo wlacz blocks_to_swap.",
 "1": {
  "class_type": "VHS_LoadVideo",
  "inputs": {"video": "{{wideo}}", "force_rate": 0, "custom_width": 0, "custom_height": 0,
             "frame_load_cap": 0, "skip_first_frames": 0, "select_every_nth": 1, "format": "AnimateDiff"}
 },
 "2": {
  "class_type": "SeedVR2LoadDiTModel",
  "inputs": {"model": "seedvr2_ema_3b_fp8_e4m3fn.safetensors", "device": "cuda:0",
             "blocks_to_swap": 0, "offload_device": "cpu", "cache_model": false, "attention_mode": "sdpa"}
 },
 "3": {
  "class_type": "SeedVR2LoadVAEModel",
  "inputs": {"model": "ema_vae_fp16.safetensors", "device": "cuda:0", "encode_tiled": true,
             "decode_tiled": true, "offload_device": "cpu", "cache_model": false}
 },
 "4": {
  "class_type": "SeedVR2VideoUpscaler",
  "inputs": {"image": ["1", 0], "dit": ["2", 0], "vae": ["3", 0], "seed": 42,
             "resolution": "{{rozdzielczosc}}", "max_resolution": 1920, "batch_size": 21,
             "uniform_batch_size": false, "color_correction": "lab", "temporal_overlap": 2,
             "input_noise_scale": 0.0, "latent_noise_scale": 0.0}
 },
 "5": {
  "class_type": "RIFE VFI",
  "inputs": {"frames": ["4", 0], "ckpt_name": "rife47.pth", "clear_cache_after_n_frames": 10,
             "multiplier": "{{mnoznik}}", "fast_mode": true, "ensemble": true, "scale_factor": 1.0}
 },
 "6": {
  "class_type": "VHS_VideoCombine",
  "inputs": {"images": ["5", 0], "frame_rate": "{{fps_wy}}", "loop_count": 0,
             "filename_prefix": "{{prefix}}", "format": "video/h264-mp4", "pix_fmt": "yuv420p",
             "crf": 14, "save_metadata": false, "pingpong": false, "save_output": true}
 }
}
