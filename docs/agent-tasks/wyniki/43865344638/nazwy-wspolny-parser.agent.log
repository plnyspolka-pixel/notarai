_PRZYKLAD = {
    "zbywca": "Sobczak", "nabywca": "Pawlak", "strony": "Sobczak - Pawlak", 
"czynnosc": "sprzedaż",
    "miejscowosc": "Zalesie", "sygnatura": "A 123/2026", "data": "2026-11-13", 
"nazwa": "Sobczak – Pawlak",
}


def nieznane_pola_wzoru(wzor: str) -> list[str]:
