def oplata(zadania: list[dict]) -> dict:
    """Oplata sadowa od wniosku: kazde zadanie liczy sie osobno (u.k.s.c. art. 
42-46)."""
    pozycje, razem = [], Decimal("0")
    for z in zadania:
        if not z["oplata"]:
            continue
        nazwa, kwota = taksa.OPLATY_SADOWE[z["oplata"]]
        pozycje.append({"zadanie": z["opis"], "podstawa": nazwa, "kwota": 
str(kwota)})
        razem += kwota
    return {"pozycje": pozycje, "razem": str(razem.quantize(Decimal("0.01")))}


def pakiet_portalu(wniosek: dict) -> list[dict]:
    """Kroki w kolejnosci formularza portalu: co i gdzie wpisac (kopiuj-wklej / 
pomocnik)."""
    kroki = [{"krok": "Sad i ksiega", "pola": {"Sad / wydzial": wniosek["sad"],
                                               "Numer księgi wieczystej": 
wniosek["numer_kw"]}}]
    for u in wniosek["uczestnicy"]:
        pola = {"Rola": u["rola"], "Nazwa / imie i nazwisko": u["nazwa"]}
        pola.update({k: v for k, v in (("PESEL", u["pesel"]), ("KRS/REGON", 
u["krs"]),
                                       ("Imiona rodziców", 
u["imiona_rodzicow"]),
                                       ("Adres", u["adres"])) if v})
        kroki.append({"krok": "Uczestnik", "pola": pola})
    for z in wniosek["zadania"]:
        pola = {"Dzial": DZIALY[z["dzial"]], "Zadanie": z["opis"]}
        if z["tresc"]:
            pola["Treść żądania"] = z["tresc"]
        if z["na_rzecz"]:
            pola["Na rzecz"] = ", ".join(z["na_rzecz"]) + (f" ({z['udzial']})" 
if z["udzial"] else "")
        if z.get("suma"):
            pola["Suma hipoteki"] = f"{z['suma']} {z['waluta']} 
({z['rodzaj_hipoteki']})"
        kroki.append({"krok": "Zadanie", "pola": pola})
    p = wniosek["podstawa"]
    kroki.append({"krok": "Podstawa wpisu - akt notarialny",
                  "pola": {"Numer rep. A": p["rep_a"], "Data sporządzenia": 
p["data"],
                           "Notariusz": p["notariusz"], "Siedziba kancelarii": 
p["siedziba"],
                           **({"Identyfikator wypisu w CREWAN": 
p["id_wypisu_crewan"]} if p["id_wypisu_crewan"] else {})}})
    if wniosek["dokumenty"]:
        kroki.append({"krok": "Dokumenty dołączone", "pola": {f"Dokument {i}": d
for i, d in
                                                               enumerate(wniosek
["dokumenty"], 1)}})
    kroki.append({"krok": "Opłata sądowa", "pola": {"Razem": 
f"{wniosek['oplata']['razem']} zł"}})
    kroki.append({"krok": "STOP - podpis i wyslanie", "pola": {
        "Kto": "notariusz, kwalifikowanym podpisem elektronicznym w portalu MS",
        "Potem": "wpisz w notarai numer REP.C - wniosek trafi do repertorium 
C"}})
    return kroki


def definicje() -> dict:
    return {"dzialy": DZIALY, "zadania": {k: {"dzial": v[0], "oplata": v[1], 
"opis": v[2]}
                                          for k, v in ZADANIA.items()}, "role": 
ROLE}


def dane_formularza(wniosek: dict) -> dict:
    """Plaskie wartosci pod `zrodlo` z formularze/wniosek_kw_portal_ms.yaml."""
    dane = {"sad": wniosek["sad"], "numer_kw": wniosek["numer_kw"],
            "rep_a": wniosek["podstawa"]["rep_a"], "data_aktu": 
wniosek["podstawa"]["data"]}
    for i, u in enumerate(wniosek["uczestnicy"], 1):
        dane[f"uczestnik_{i}_nazwa"], dane[f"uczestnik_{i}_pesel"] = u["nazwa"],
u["pesel"]
    for i, z in enumerate(wniosek["zadania"], 1):
        dane[f"zadanie_{i}_dzial"] = z["dzial"]
        dane[f"zadanie_{i}_tresc"] = z["tresc"] or (z["opis"] + (" na rzecz " + 
", ".join(z["na_rzecz"])
                                                                  if 
z["na_rzecz"] else ""))
    return dane

