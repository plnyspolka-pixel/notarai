import taksa

NOWE = date(2026, 11, 7)    # po zmianie z 5.11.2026
STARE = date(2026, 11, 4)   # dzien przed


class TestStawkaPodstawowa:
    @pytest.mark.parametrize("wartosc, oczekiwana", [
        (1, "100"), (3000, "100"),
        (3001, "100.03"), (10000, "310"),
        (20000, "510"), (30000, "710"),
        (45000, "860"), (60000, "1010"),
