        assert taksa.stawka_podstawowa(wartosc, NOWE) == (Decimal(oczekiwana), 
False)

    def test_limit_nowy_25000(self):
        assert taksa.stawka_podstawowa(20_000_000, NOWE) == (Decimal("25000"), 
True)

