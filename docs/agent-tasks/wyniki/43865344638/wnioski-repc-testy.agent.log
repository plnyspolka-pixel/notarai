# Wzorce plikow testowych
python_files = test_*.py
python_classes = Test*
python_functions = test_*

# Opcje wyswietlania
addopts =
    -v
    --strict-markers
    --tb=short
    --color=yes

# Katalogi ignorowane
norecursedirs = .git .venv venv dane build dist *.egg-info

# Markery (na przyszlosc)
markers =
    slow: testy wymagajace wiecej czasu
    integration: testy integracyjne
    unit: testy jednostkowe

# Ostrzezenia
filterwarnings =
    error
    ignore::DeprecationWarning
    ignore::PendingDeprecationWarning
"""Wspólne funkcje pomocnicze dla testów."""
from walidacja import WAGI_PESEL


def z_suma_kontrolna(dziesiec_cyfr: str) -> str:
    """Dodaje cyfrę kontrolną PESEL do 10-cyfrowego prefiksu."""
    suma = sum(int(c) * w for c, w in zip(dziesiec_cyfr, WAGI_PESEL))
    return dziesiec_cyfr + str((10 - suma % 10) % 10)


