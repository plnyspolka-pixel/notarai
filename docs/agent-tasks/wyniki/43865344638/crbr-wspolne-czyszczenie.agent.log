# --- Zapytanie 
-------------------------------------------------------------------


def sprawdz(nip: str | None = None, krs: str | None = None, nazwa: str | None = 
None,
            klient: httpx.Client | None = None) -> WynikCRBR:
    """Jedno zapytanie do bramki CRBR. Kolejnosc kryteriow: NIP, KRS, nazwa."""
    n, k, naz = normalizuj_nip(nip), normalizuj_krs(krs), (nazwa or "").strip()
    if n:
        pole, wartosc = "NIP", n
    elif k:
        pole, wartosc = "KRS", k
    elif len(naz) >= 3:
        pole, wartosc = "Nazwa", naz
    else:
        return WynikCRBR("bledne_dane", "Podaj poprawny NIP (10 cyfr), KRS albo 
nazwe spolki (min. 3 znaki).",
                         kod="INVALID_INPUT")
    start = time.time()
    try:
        wlasny = klient is None
        klient = klient or httpx.Client(timeout=25)
        try:
            odp = klient.post(ADRES, content=koperta(pole, 
wartosc).encode("utf-8"),
                              headers={"Content-Type": "application/soap+xml; 
charset=utf-8"})
        finally:
            if wlasny:
                klient.close()
    except httpx.TimeoutException:
        return WynikCRBR("blad", "Bramka CRBR nie odpowiedziala w 25 s.", 
kod="TIMEOUT")
    except httpx.HTTPError as blad:
        return WynikCRBR("blad", f"Blad sieci przy polaczeniu z bramka CRBR 
({type(blad).__name__}).",
                         kod="NETWORK_ERROR")
    wynik = parsuj_odpowiedz(odp.text, pole, wartosc)
    if wynik.status == "blad" and wynik.kod != "SOAP_FAULT" and odp.status_code 
>= 400:
        wynik = WynikCRBR("blad", f"Bramka CRBR zwrocila HTTP 
{odp.status_code}", kod=f"HTTP_{odp.status_code}")
    log.info("CRBR %s=%s: status=%s czas=%.1fs", pole, wartosc if pole != 
"Nazwa" else "(nazwa)",
             wynik.status, time.time() - start)
    return wynik


# --- Dla sladu audytowego 
-----------------------------------------------------------


def _norm(s: str) -> str:
    import unicodedata
    t = unicodedata.normalize("NFKD", (s or "").lower())
    t = "".join(c for c in t if not unicodedata.combining(c) and (c.isalpha() or
c.isspace()))
    return re.sub(r"\s+", " ", t).strip()


def dopasuj_osoby(imiona_nazwiska: list[str], osoby: list[Osoba]) -> dict[str, 
bool]:
    """Ktore ze stron czynnosci sa wsrod beneficjentow (po imieniu i 
nazwisku)."""
    lista = [set(_norm(o.imie_nazwisko).split()) for o in osoby]
    wynik = {}
    for nazwa in imiona_nazwiska:
        n = set(_norm(nazwa).split())
        # "Jan Kowalski" pasuje do "Jan Maria Kowalski": imie i nazwisko strony
        # musza byc wsrod slow beneficjenta (drugie imie nie przeszkadza).
        wynik[nazwa] = len(n) >= 2 and any(b and n <= b for b in lista)
    return wynik


def opis_dla_sladu(w: WynikCRBR) -> str:
    """Tekst do sprawdzenia.json: spolka, beneficjenci i reprezentanci z
    zamaskowanymi PESEL-ami. Nazwiska beneficjentow to tresc jawnego 
rejestru."""
    if w.status != "ok" or not w.spolka:
        return w.komunikat
    czesci = [f"{w.spolka.nazwa or '?'} (NIP {w.spolka.nip or '?'}, KRS 
{w.spolka.krs or '?'})"]
    if w.beneficjenci:
        czesci.append("Beneficjenci: " + "; ".join(
            f"{o.imie_nazwisko}" + (f" ur. {o.data_urodzenia}" if 
o.data_urodzenia else "")
            + (f" ({o.uprawnienia})" if o.uprawnienia else "") for o in 
w.beneficjenci))
    if w.zglaszajacy:
        czesci.append("Zglaszajacy: " + "; ".join(
            f"{o.imie_nazwisko}" + (f" - {o.funkcja}" if o.funkcja else "") for 
o in w.zglaszajacy))
    if w.data_wniosku:
        czesci.append(f"wniosek {w.identyfikator_wniosku or ''} z 
{w.data_wniosku}".strip())
    return " | ".join(czesci)

