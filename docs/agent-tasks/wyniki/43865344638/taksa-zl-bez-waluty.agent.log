# ---------------------------------------------------------------- prezentacja

def zl(x, waluta: bool = True) -> str:
    """1234.5 -> '1 234,50 zł' (twarde spacje jak w C.A.R.).

    waluta=False: sama liczba, bez twardej spacji i 'zł' na końcu."""
