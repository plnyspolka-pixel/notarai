import re
src = open('taksa.py', encoding='utf-8').read()
old = '''def zl(x) -> str:
    """1234.5 -> '1 234,50 z\u0142' (twarde spacje jak w C.A.R.)."""
    calkowite, grosze_ = f"{grosze(x):.2f}".split(".")
    with_sep = ""
    for i, cyfra in enumerate(reversed(calkowite)):
        if i and i % 3 == 0:
            with_sep = "\\u00a0" + with_sep
        with_sep = cyfra + with_sep
    return f"{with_sep},{grosze_}\\u00a0z\\u0142"'''
new = '''def zl(x, waluta: bool = True) -> str:
    """1234.5 -> '1 234,50 z\u0142' (twarde spacje jak w C.A.R.).

    waluta=False: sama liczba, bez twardej spacji i 'z\u0142' na koncu."""
    calkowite, grosze_ = f"{grosze(x):.2f}".split(".")
    with_sep = ""
    for i, cyfra in enumerate(reversed(calkowite)):
        if i and i % 3 == 0:
            with_sep = "\\u00a0" + with_sep
        with_sep = cyfra + with_sep
    liczba = f"{with_sep},{grosze_}"
    if not waluta:
        return liczba
    return f"{liczba}\\u00a0z\\u0142"'''
assert old in src
open('taksa.py', 'w', encoding='utf-8').write(src.replace(old, new))
print("done")
