        assert nazwiska_stron(pola) == {"zbywcy": ["Sobczak"], "nabywcy": 
["Pawlak", "Nowak"], "inni": []}

    def test_z_pol_rol(self):
        pola = [{"nazwa": "bbb: nabywcy", "wartosc": "Marian i Anna małżonkowie 
Nowak"},
                {"nazwa": "aaa: zbywca", "wartosc": "TOMASZ PIOTR SOBCZAK, 
STANISŁAW, HALINA, 85031512337"}]
        assert nazwiska_stron(pola) == {"zbywcy": ["Sobczak"], "nabywcy": 
["Nowak"], "inni": []}

    def test_z_plikow_gdy_brak_pol(self):
        assert nazwiska_stron([], ["Sobczak Tomasz - Pawlak Grzegorz - sprzedaż 
RI - Zalesie.pdf"]) == \
            {"zbywcy": ["Sobczak"], "nabywcy": ["Pawlak"], "inni": []}


class TestNazwaPliku:
