"wartosc": "Sobczak - Pawlak"},
            {"nazwa": "STALE: miejscowosc polozenia nieruchomosci - obreb", 
"wartosc": "Zalesie: dz. 12/3, 14\nBorki: 5"}]

    def test_domyslny_wzor_jak_w_kancelarii(self):
        assert nazwa_pliku(DOMYSLNY_WZOR_NAZWY, self.POLA, 
rodzaje=["sprzedaz_rolna"]) == "Sobczak - Pawlak - sprzedaż - Zalesie"

    def test_puste_pole_znika_z_myslnikiem(self):
        assert nazwa_pliku(DOMYSLNY_WZOR_NAZWY, self.POLA, rodzaje=["inny"]) == 
"Sobczak - Pawlak - Zalesie"
        tylko_zbywca = [{"nazwa": "aaa: zbywca", "wartosc": "Jan Kowalski"}]
        assert nazwa_pliku(DOMYSLNY_WZOR_NAZWY, tylko_zbywca) == "Kowalski"

    def test_bez_danych_numer_sprawy(self):
        assert nazwa_pliku(DOMYSLNY_WZOR_NAZWY, [], identyfikator="abc123") == 
"projekt-abc123"
        assert nazwa_pliku(DOMYSLNY_WZOR_NAZWY, []) == "projekt"

    def test_inne_pola_i_wlasny_separator(self):
        wynik = nazwa_pliku("{sygnatura}_{data}_{nazwa}", self.POLA, 
sygnatura="A 123/2026",
                            utworzono="2026-11-13T10:00:00", nazwa="Sobczak – 
Pawlak")
        assert wynik == "A 123-2026_2026-11-13_Sobczak – Pawlak"

    def test_kilku_nabywcow(self):
        pola = [{"nazwa": "STALE: nazwiska stron czynnosci", "wartosc": "Sobczak
- Pawlak - Nowak"}]
        assert nazwa_pliku("{zbywca} - {nabywca}", pola) == "Sobczak - Pawlak i 
Nowak"
        assert nazwa_pliku("{strony}", pola) == "Sobczak - Pawlak - Nowak"

    def test_znaki_niedozwolone_w_nazwie_pliku(self):
        pola = [{"nazwa": "STALE: miejscowosc polozenia nieruchomosci", 
"wartosc": 'Zalesie "Dolne"?'}]
        assert "?" not in nazwa_pliku("{miejscowosc}", pola) and '"' not in 
nazwa_pliku("{miejscowosc}", pola)
        assert bezpieczna_nazwa_pliku(" a/b\\c:d*e ") == "a-b-c-de"
        assert len(bezpieczna_nazwa_pliku("x" * 500)) == MAX_DLUGOSC_NAZWY

