def bezpieczna_nazwa_pliku(tekst: str, max_dlugosc: int = MAX_DLUGOSC_NAZWY) -> 
str:
    """Bez znakow niedozwolonych w Windows/macOS, bez kropek i spacji na 
koncach."""
    tekst = re.sub(r"\s*[/\\:]\s*", "-", tekst or "")   # A 123/2026 -> A 
123-2026
