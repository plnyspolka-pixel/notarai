    def test_wszystkie_pola_wypełnione_w_kolejności_wzoru(self):
        wynik = wypelnij_wzor_nazwy("{sygnatura} - {zbywca} - {nabywca}",
                                    {"zbywca": "Sobczak", "nabywca": "Pawlak", 
