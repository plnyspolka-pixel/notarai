        self.ponowione = []
        self.usunieci = []
        self.ustawione_haslo = set()

    def admin_create_user(self, **kw):
        if kw.get("MessageAction") == "RESEND":
            if kw["Username"] in self.ustawione_haslo:
                raise _wyjatek("UnsupportedUserStateException")
            self.ponowione.append(kw["Username"])
            return
        if kw["Username"] in self.utworzeni:
            raise _wyjatek("UsernameExistsException")
        super().admin_create_user(**kw)

"""Wspólne funkcje pomocnicze dla testów."""
from walidacja import WAGI_PESEL


def z_suma_kontrolna(dziesiec_cyfr: str) -> str:
    """Dodaje cyfrę kontrolną PESEL do 10-cyfrowego prefiksu."""
    suma = sum(int(c) * w for c, w in zip(dziesiec_cyfr, WAGI_PESEL))
    return dziesiec_cyfr + str((10 - suma % 10) % 10)


