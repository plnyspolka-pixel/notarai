    31      return True, f"ur. {urodzenie.isoformat()}, plec {plec}"
    32  
    33  
    34  def _data_z_peselu(cyfry: str) -> date | None:
    35      rok, miesiac, dzien = int(cyfry[0:2]), int(cyfry[2:4]), 
int(cyfry[4:6])
    36      stulecia = {0: 1900, 1: 2000, 2: 2100, 3: 2200, 4: 1800}
    37      baza = stulecia.get(miesiac // 20)
    38      if baza is None:
    39          return None
    40      try:
    41          return date(baza + rok, miesiac % 20, dzien)
    42      except ValueError:
    43          return None
    44  
    45  
    46  def nip(wartosc: str) -> tuple[bool, str]:
    47      cyfry = re.sub(r"\D", "", wartosc or "")
    48      if len(cyfry) != 10:
    49          return False, "NIP musi miec 10 cyfr"
    50      suma = sum(int(c) * w for c, w in zip(cyfry[:9], WAGI_NIP))
    51      if suma % 11 == 10 or suma % 11 != int(cyfry[9]):
    52          return False, "Bledna suma kontrolna NIP"
    53      return True, "NIP poprawny"
    54  
    55  
    56  def ksiega_wieczysta(wartosc: str) -> tuple[bool, str]:
    57      """Format: XXXX/00000000/C - kod wydzialu, numer, cyfra 
kontrolna."""
    58      tekst = (wartosc or "").upper().replace(" ", "")
    59      dopasowanie = re.fullmatch(r"([A-Z0-9]{4})/(\d{8})/(\d)", tekst)
    60      if not dopasowanie:
    61          return False, "Format numeru KW: XXXX/00000000/C"
    62  
    63      kod, numer, kontrolna = dopasowanie.groups()
    64      suma = 0
    65      for i, znak in enumerate(kod + numer):
    66          if znak not in _ZNAKI_KW:
    67              return False, f"Niedozwolony znak w numerze KW: {znak}"
    68          waga = (1, 3, 7)[i % 3]
    69          suma += _ZNAKI_KW.index(znak) * waga
    70      if suma % 10 != int(kontrolna):
    71          return False, "Bledna cyfra kontrolna numeru KW"
    72      return True, "Numer KW poprawny"
    73  
    74  
    75  def kwota(wartosc: str) -> tuple[bool, str]:
    76      tekst = re.sub(r"[\s\u00a0]", "", wartosc or "").replace(",", ".")
    77      tekst = re.sub(r"(zł|zl|PLN)\.?\$""):
    78          # Pole nazwane z kontekstu ("??5: nr __, wazny do dnia __ r.), 
PESEL __").
    79          # Regule dobieramy tylko po slowach tuz przed luka, inaczej 
"PESEL"
    80          # z dalszej czesci zdania zwalidowalby date waznosci dowodu.
    81          przed_luka = re.search(r"((?:\S+\s+){0,2})__", klucz)
    82          klucz = przed_luka.group(1) if przed_luka else ""
    83      for wzorzec, funkcja in REGULY.items():
    84          if 
re.search(rf"(?<![a-ząćęłńóśźż0-9]){wzorzec}(?![a-ząćęłńóśźż0-9])", klucz):
    85              return funkcja(wartosc)
    86      return None, ""

