bool(c.get("hipoteka"))}
                  for c in CZYNNOSCI_STALE],
        "opcje": {k: {"nazwa": v["nazwa"], "kwota": 
_liczba_json(v["kwoty"][t["id"]])} for k, v in OPCJE.items()},
        "oplaty_sadowe": {k: {"nazwa": v[0], "kwota": _liczba_json(v[1])} for k,
