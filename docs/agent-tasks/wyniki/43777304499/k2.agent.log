runnera.

Polecenia:
  check                 karty, ceny i nasze grupy (nic nie kosztuje)
  up --pay              utwórz grupę z vLLM (płatne od chwili stanu `running`)
  status                stan grupy i tego, czy model już odpowiada
  proxy                 127.0.0.1:PORT -> brama Salad (dokleja klucz); po 
terminie usuwa grupę
Całość bez komputera operatora uruchamia workflow .github/workflows/koder.yml.
  down                  usuń grupę (zawsze na koniec)

Zasady: węzły Salad to cudze komputery poza UE -> wyłącznie kod z publicznego 
repo i dane
syntetyczne, nigdy `dane/`, `.env` ani nic o klientach. Klucz Salad tylko ze 
środowiska albo
z pliku wskazanego w NOTARAI_SALAD_ENV (poza repo); nie trafia do logów ani do 
kontenera.
Narzędzie rusza wyłącznie grupy o nazwie zaczynającej się od `notarai-koder`.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timedelta, timezone
import http.client
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
from pathlib import Path
import re
import sys
import threading
import time

API_HOST = "api.salad.com"
API_BASE = "/api/public"
LABEL = "notarai-koder"
NAME_RE = re.compile(r"^[a-z][a-z0-9-]{0,61}[a-z0-9]$")
DNS_RE = re.compile(r"^[a-z0-9.-]+\.salad\.cloud$", re.I)
STATE = Path(__file__).resolve().parents[2] / ".agent-forge" / 
"salad-koder.json"

# Domyślny model: Qwen3.8-27B w 4 bitach (19,5 GB wag, Apache 2.0, bez bramki) -
najmocniejszy
# otwarty model do pracy agentowej mieszczący się na jednej karcie 32 GB 
(przegląd 16.11.2026).
# Zapas dla kart 24 GB: cyankiwi/Qwen3-Coder-30B-A3B-Instruct-AWQ-4bit z 
parserem qwen3_xml.
DEFAULT_MODEL = "RedHatAI/Qwen3.8-27B-INT4"
DEFAULT_PARSER = "qwen3_coder"  # wg recipes.vllm.ai/Qwen/Qwen3.8-27B
DEFAULT_VLLM_ARGS = "--kv-cache-dtype fp8 --language-model-only --enforce-eager 
--reasoning-parser qwen3"
DEFAULT_IMAGE = "vllm/vllm-openai:latest"
SERVED_NAME = "koder"
PORT = 8000
HOP = {"connection", "keep-alive", "proxy-authenticate", "proxy-authorization", 
"te",
       "trailers", "transfer-encoding", "upgrade", "host", "content-length"}


class SaladError(RuntimeError):
    pass


def load_keys() -> dict[str, str]:
    keys = {k: os.environ.get(k, "") for k in ("SALAD_API_KEY", "SALAD_ORG", 
"SALAD_PROJECT")}
    path = os.environ.get("NOTARAI_SALAD_ENV")
    if path and Path(path).is_file():
        for line in Path(path).read_text(encoding="utf-8").splitlines():
            m = re.match(r"^(SALAD_API_KEY|SALAD_ORG|SALAD_PROJECT)=(.*)$", 
line.strip())
            if m and not keys[m.group(1)]:
                keys[m.group(1)] = m.group(2).strip().strip('"').strip("'")
    keys["SALAD_PROJECT"] = keys["SALAD_PROJECT"] or "default"
    if not keys["SALAD_API_KEY"]:
        raise SaladError("Brak SALAD_API_KEY (środowisko albo plik z 
NOTARAI_SALAD_ENV)")
    for k in ("SALAD_ORG", "SALAD_PROJECT"):
        if not NAME_RE.fullmatch(keys[k]):
            raise SaladError(f"Zła albo pusta wartość {k}")
    return keys


def api(keys: dict, method: str, path: str, body: dict | None = None, allow404: 
bool = False):
    conn = http.client.HTTPSConnection(API_HOST, timeout=30)
    try:
        headers = {"Salad-Api-Key": keys["SALAD_API_KEY"], "Accept": 
"application/json"}
        data = None
        if body is not None:
            data = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = "application/json"
        conn.request(method, API_BASE + path, body=data, headers=headers)
        res = conn.getresponse()
        text = res.read().decode("utf-8", "replace")
        if res.status == 404 and allow404:
            return None
        if res.status >= 300:
            raise SaladError(f"Salad HTTP {res.status} {method} {path}: 
{text[:300]}")
        try:
            return json.loads(text) if text else {}
        except ValueError:
            return {}
    finally:
        conn.close()


def groups_path(keys: dict) -> str:
    return 
f"/organizations/{keys['SALAD_ORG']}/projects/{keys['SALAD_PROJECT']}/containers
"


def group_path(keys: dict, name: str) -> str:
    if not NAME_RE.fullmatch(name) or not name.startswith(LABEL):
        raise SaladError(f"Grupa {name} nie jest nasza - nie ruszam")
    return f"{groups_path(keys)}/{name}"


def our_groups(keys: dict) -> list[dict]:
    items = (api(keys, "GET", groups_path(keys)) or {}).get("items") or []
    return [g for g in items if str(g.get("name", "")).startswith(LABEL)]


def gpu_classes(keys: dict, priority: str) -> list[dict]:
    items = (api(keys, "GET", f"/organizations/{keys['SALAD_ORG']}/gpu-classes")
or {}).get("items") or []
    out = []
    for c in items:
        m = re.search(r"\((\d+)\s*GB\)", str(c.get("name", "")))
        price = next((float(p["price"]) for p in c.get("prices") or []
                      if p.get("priority") == priority), None)
        if m and price is not None:
            out.
