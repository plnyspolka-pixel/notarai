def test_gpu_classes(monkeypatch):
    import tools.agent_factory.salad_vllm as mod
    items = {
        "items": [
            {"id": "a", "name": "AMD RX 7900 XTX (24GB)",
             "prices": [{"priority": "high", "price": "2.50"},
                        {"priority": "low", "price": "1.00"}]},
            {"id": "b", "name": "RTX 5090 (32 GB)",
