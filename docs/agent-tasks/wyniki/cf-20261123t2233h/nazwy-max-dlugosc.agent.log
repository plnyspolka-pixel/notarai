["Nowak"]

    def test_dwie_osoby(self):
        assert nazwiska_z_wartosci("Jan Kowalski i Anna Nowak-Wiśniewska") == 
["Kowalski", "Nowak-Wiśniewska"]

    def test_samo_nazwisko(self):
        assert nazwiska_z_wartosci("PAWLAK", tylko_nazwisko=True) == ["Pawlak"]


