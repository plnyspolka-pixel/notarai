"""Nazwa sprawy z nazwisk stron. Dane zmyslone albo z nazw plikow testowych."""
from nazwy import (DOMYSLNY_WZOR_NAZWY, MAX_DLUGOSC_NAZWY, 
bezpieczna_nazwa_pliku, czynnosc_z_rodzajow,
                   miejscowosc_z_pol, nazwa_pliku, nazwa_sprawy, nazwiska_stron,
nazwiska_z_plikow,
