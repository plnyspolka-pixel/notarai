        poprawny, komunikat = sprawdz_pole("NIP firmy", "1234563218")
        assert poprawny is True

    def test_pole_z_kw(self):
        poprawny, komunikat = sprawdz_pole("numer KW", "KR1K/00012345/7")
        assert poprawny is True

    def test_pole_z_ksiega(self):
