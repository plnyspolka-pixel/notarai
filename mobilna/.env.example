# Adres serwera notarai. Skopiuj do .env (plik .env jest poza gitem).
# Produkcja (domyślnie, gdy zmiennej nie ma):
EXPO_PUBLIC_API_URL=https://app.notarai.pl
# Przeglądarka (npm run web) z lokalnym backendem:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Emulator Androida widzi komputer pod 10.0.2.2:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# Telefon z Expo Go w tej samej sieci: adres IP komputera
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8000
