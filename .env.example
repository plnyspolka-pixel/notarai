# pieczapp - konfiguracja (skopiuj do .env albo ustaw w App Runner)
# ZADNYCH kluczy AWS tutaj. Lokalnie: profil AWS. W chmurze: rola IAM.

# --- Podstawy ---------------------------------------------------------------
AWS_REGION=eu-central-1
# Model. Profile od wersji 4.7 wzwyz czytaja obraz w wyzszej rozdzielczosci,
# ale na koncie fbpl sa zablokowane po stronie AWS (odmowa takze dla konta
# glownego, mimo zaakceptowanych umow). Po odblokowaniu wystarczy podmienic
# te wartosc - rozmiar obrazu i parametry zapytania dostosuja sie same.
PIECZAPP_MODEL=eu.anthropic.claude-opus-4-6-v1
# Dlugosc dluzszego boku obrazu strony. Puste = dobierane do modelu
# (2576 px dla modeli 4.7+, 1568 px dla starszych). Nie podnos ponad limit
# modelu - nadmiar i tak zostanie pomniejszony, a zaplacisz za przeslanie.
PIECZAPP_MAX_BOK=
# Profil AWS. Pusto = standardowy lancuch poswiadczen (rola instancji w chmurze).
# Stanowisko lokalne: uruchom.bat ustawia pieczapp, czyli konto fbpl 127621462971.
# W kontenerze ZOSTAW PUSTE - profile tam nie istnieja.
PIECZAPP_AWS_PROFILE=

PIECZAPP_HOST=127.0.0.1
PIECZAPP_PORT=8000

# --- Magazyn plikow ---------------------------------------------------------
# lokalny = dysk (jak dotychczas)  |  s3 = SaaS (dysk jako cache + S3)
PIECZAPP_MAGAZYN=lokalny
PIECZAPP_S3_BUCKET=
PIECZAPP_S3_PREFIKS=kancelarie
# Opcjonalny klucz KMS do szyfrowania obiektow (bez niego: AES256 zarzadzany przez S3)
PIECZAPP_KMS_KEY_ID=

# --- Tryb wielu kancelarii (SaaS) -------------------------------------------
# true = kazde zadanie /api/* wymaga Bearer tokenu kancelarii
PIECZAPP_MULTI=false
# Token administratora do /api/admin/* (wygeneruj: openssl rand -hex 32)
PIECZAPP_ADMIN_TOKEN=

# --- Parametry przetwarzania (opcjonalne) -----------------------------------
PIECZAPP_DPI=220
PIECZAPP_MAX_BOK=2400
PIECZAPP_MAX_STRON=40

# --- Kalkulator kosztow dla klientow (publiczny, bez logowania) --------------
# false = zostaje sam formularz (bez rozmowy z modelem)
PIECZAPP_KALKULATOR=true
# Limity rozmowy z modelem: na adres IP na godzine i lacznie na dobe (na proces)
PIECZAPP_KALKULATOR_NA_IP=40
PIECZAPP_KALKULATOR_NA_DOBE=1500
# Domeny, z ktorych strona moze wolac /api/taksa (CORS), po przecinku
PIECZAPP_KALKULATOR_ORIGINS=https://notarai.pl,https://www.notarai.pl
# Osobny profil modelu dla rozmowy z klientem (limit zapytan Bedrock liczy sie
# na model, wiec publiczny czat nie dlawi odczytu skanow). Pusto = PIECZAPP_MODEL.
PIECZAPP_KALKULATOR_MODEL=eu.anthropic.claude-sonnet-4-6

# --- Umawianie wizyt (zgloszenia klientow ze strony notarai.pl) -------------
# Nadawca e-maili (zweryfikowany w Amazon SES, eu-central-1). Pusto = bez wysylki,
# zgloszenia i tak widac w aplikacji (Zapytania klientow) i w panelu /admin.
PIECZAPP_EMAIL_NADAWCA=
# Kopia kazdego zgloszenia dla obslugi notarai
PIECZAPP_EMAIL_ZGLOSZEN=
# Limity zgloszen: na adres IP na godzine i lacznie na dobe; retencja w dniach
PIECZAPP_WIZYTY_NA_IP=5
PIECZAPP_WIZYTY_NA_DOBE=300
PIECZAPP_WIZYTY_RETENCJA_DNI=180
