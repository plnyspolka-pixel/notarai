# pieczapp - konfiguracja (skopiuj do .env albo ustaw w App Runner)
# ZADNYCH kluczy AWS tutaj. Lokalnie: profil AWS. W chmurze: rola IAM.

# --- Podstawy ---------------------------------------------------------------
AWS_REGION=eu-central-1
# Model. Profile od wersji 4.7 wzwyz czytaja obraz w wyzszej rozdzielczosci,
# ale na koncie fbpl sa zablokowane po stronie AWS (odmowa takze dla konta
# glownego, mimo zaakceptowanych umow). Po odblokowaniu wystarczy podmienic
# te wartosc - rozmiar obrazu i parametry zapytania dostosuja sie same.
PIECZAPP_MODEL=eu.anthropic.claude-opus-4-6-v1
# Dlugosc dluzszego boku obrazu strony. Puste = dobierane do modelu
# (2576 px dla modeli 4.7+, 1568 px dla starszych). Nie podnos ponad limit
# modelu - nadmiar i tak zostanie pomniejszony, a zaplacisz za przeslanie.
PIECZAPP_MAX_BOK=
# Profil AWS. Pusto = standardowy lancuch poswiadczen (rola instancji w chmurze).
# Stanowisko lokalne: uruchom.bat ustawia pieczapp, czyli konto fbpl 127621462971.
# W kontenerze ZOSTAW PUSTE - profile tam nie istnieja.
PIECZAPP_AWS_PROFILE=

PIECZAPP_HOST=127.0.0.1
PIECZAPP_PORT=8000

# --- Magazyn plikow ---------------------------------------------------------
# lokalny = dysk (jak dotychczas)  |  s3 = SaaS (dysk jako cache + S3)
PIECZAPP_MAGAZYN=lokalny
PIECZAPP_S3_BUCKET=
PIECZAPP_S3_PREFIKS=kancelarie
# Opcjonalny klucz KMS do szyfrowania obiektow (bez niego: AES256 zarzadzany przez S3)
PIECZAPP_KMS_KEY_ID=

# --- Tryb wielu kancelarii (SaaS) -------------------------------------------
# true = kazde zadanie /api/* wymaga Bearer tokenu kancelarii
PIECZAPP_MULTI=false
# Token administratora do /api/admin/* (wygeneruj: openssl rand -hex 32)
PIECZAPP_ADMIN_TOKEN=

# --- Parametry przetwarzania (opcjonalne) -----------------------------------
PIECZAPP_DPI=220
PIECZAPP_MAX_BOK=2400
PIECZAPP_MAX_STRON=40

# --- Ksiegi wieczyste z EKW (opcjonalne) -----------------------------------
# Token konta Apify (Settings -> API & Integrations). Wlacza przycisk "Pobierz
# z EKW": tresc ksiegi pobiera aktor regdata/ekw-ksiegi-wieczyste-scraper,
# platny za wynik. Puste = funkcja wylaczona. W chmurze NIE wpisuj tu wartosci:
# token idzie z sekretu notarai/apify (infra\zapisz-sekret-apify.ps1).
PIECZAPP_APIFY_TOKEN=

# --- Finance You jako dostawca tresci KW (ma pierwszenstwo przed Apify) ------
# Adres API Finance You i token partnerski (KW_PARTNER_TOKEN po stronie
# Finance You). Finance You sam dobiera zrodlo (Apify -> EasyMKW) i oddaje
# piec dzialow; w procedurze kancelarii dostawca tresci KW to Finance You.
# W chmurze token idzie z sekretu notarai/finyou (infra\zapisz-sekret-finyou.ps1),
# adres parametrem FinyouAdres w 3-wdroz-aplikacje.ps1.
PIECZAPP_FINYOU_URL=
PIECZAPP_FINYOU_TOKEN=

# --- Tokenomia: kredyty za czynnosci z modelem (tokenomia.py, docs/tokenomia.md)
# true = kancelaria placi kredytami (pula z abonamentu + pakiety); false = koszty
# tylko liczone w logach i w panelu admina (/api/admin/tokenomia).
PIECZAPP_TOKENOMIA=false
# Plan abonamentu Stripe (STRIPE_CENA) w tokenomii: start | kancelaria | pro
PIECZAPP_PLAN_DOMYSLNY=kancelaria
# Ile kredytow ponizej zera wolno zejsc, zeby nie przerwac aktu w polowie.
PIECZAPP_DEBET_KREDYTOW=30
PIECZAPP_KREDYTY_PROBNE=150
# Parametry kosztow (sprawdz aktualne stawki Bedrock i kurs):
PIECZAPP_KURS_USD=3.70
PIECZAPP_PREMIA_REGIONALNA=1.10
PIECZAPP_KOSZT_EKW_ZL=1.80
PIECZAPP_NARZUT=1.0
# --- AML: listy sankcyjne, PEP, CRBR (docs/rejestry.md) --------------------
# 0 = nie odswiezaj list w tle (np. stanowisko bez internetu; wtedy przycisk admina)
PIECZAPP_AML_LISTY=1
# Lista OFAC (USA) - dla notariusza w Polsce nieobowiazkowa; 1 wlacza
PIECZAPP_AML_OFAC=0
# Wlasny token do listy UE FSF (bez niego publiczny token z dokumentacji FSF)
PIECZAPP_EU_FSF_TOKEN=
# User-Agent z kontaktem - Wikidata i gov.pl prosza o identyfikacje klienta
PIECZAPP_AML_KONTAKT=notarai-AML/1.0 (+https://notarai.pl)
