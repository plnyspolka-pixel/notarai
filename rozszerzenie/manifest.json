{
  "manifest_version": 3,
  "name": "NotarAI — asystent w przeglądarce",
  "short_name": "NotarAI",
  "version": "0.1.1",
  "description": "Asystent NotarAI w panelu bocznym Chrome: pomaga obsługiwać strony urzędów i rejestrów bez samodzielnego wysyłania, składania ani podpisywania dokumentów.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "ikony/16.png",
    "48": "ikony/48.png",
    "128": "ikony/128.png"
  },
  "action": {
    "default_title": "Otwórz panel NotarAI"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "tlo.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://app.notarai.pl/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
