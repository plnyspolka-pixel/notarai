					</xsd:choice>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="Ulica" type="TAdresUlica"> </xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TAdresTERYT">
		<xsd:sequence>
			<xsd:element name="Kraj" type="TAdresKraj"/>
			<xsd:element name="KodPocztowy" minOccurs="0">
				<xsd:complexType>
					<xsd:choice>
						<xsd:element name="KodPL" type="TAdresKodPL"/>
						<xsd:element name="Kod" type="TAdresKod"/>
					</xsd:choice>
				</xsd:complexType>
			</xsd:element>
			<xsd:choice>
				<xsd:sequence>
					<xsd:element name="WOJ" type="TTERYTWojewodztwo"> </xsd:element>
					<xsd:element name="POW" type="TTERYTPowiat"> </xsd:element>
					<xsd:element name="GMI" type="TTERYTGmina" minOccurs="1"> </xsd:element>
					<xsd:element name="RODZ" type="TTERYTRodzajGminy"> </xsd:element>
					<xsd:element name="SIMC" type="TTERYTMiejsce"> </xsd:element>
					<xsd:element name="ULIC" type="TTERYTUlica" minOccurs="0"> </xsd:element>
					<xsd:element name="NrDomu" type="xsd:string" minOccurs="0"> </xsd:element>
					<xsd:element name="NrMieszkania" type="xsd:string" minOccurs="0"/>
					<xsd:element name="NrObrebu" type="xsd:string" minOccurs="0"> </xsd:element>
					<xsd:element name="NrDzialki" type="xsd:string" minOccurs="0"> </xsd:element>
				</xsd:sequence>
				<xsd:sequence>
					<xsd:element name="Miejscowosc" type="TAdresMiejscowosc"/>
					<xsd:element name="Ulica" type="TAdresUlica"> </xsd:element>
				</xsd:sequence>
			</xsd:choice>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TAdresTERYTmapa">
		<xsd:sequence>
			<xsd:element name="Kraj" type="TAdresKraj"/>
			<xsd:element name="KodPocztowy" minOccurs="0">
				<xsd:complexType>
					<xsd:choice>
						<xsd:element name="KodPL" type="TAdresKodPL"/>
						<xsd:element name="Kod" type="TAdresKod"/>
					</xsd:choice>
				</xsd:complexType>
			</xsd:element>
			<xsd:choice>
				<xsd:sequence>
					<xsd:element name="WOJ" type="TTERYTWojewodztwo"/>
					<xsd:element name="POW" type="TTERYTPowiat"/> 
					<xsd:element name="GMI" type="TTERYTGmina" minOccurs="1"/> 
					<xsd:element name="RODZ" type="TTERYTRodzajGminy"/> 
					<xsd:element name="SIMC" type="TTERYTMiejsce"/> 
					<xsd:element name="ULIC" type="TTERYTUlica" minOccurs="0"/> 
					<xsd:element name="NrDomu" type="xsd:string" minOccurs="0"/> 
					<xsd:element name="NrMieszkania" type="xsd:string" minOccurs="0"/>
					<xsd:element name="NrArkuszaMapy" type="TTERYTNrArkuszaMapy" minOccurs="0"/> 
					<xsd:element name="NrObrebu" type="xsd:string" minOccurs="0"/> 
					<xsd:element name="NrDzialki" type="xsd:string" minOccurs="0"/> 
				</xsd:sequence>
				<xsd:sequence>
					<xsd:element name="Miejscowosc" type="TAdresMiejscowosc"/>
					<xsd:element name="Ulica" type="TAdresUlica"> </xsd:element>
				</xsd:sequence>
			</xsd:choice>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TOsPrawnaUproszczona">
		<xsd:sequence>
			<xsd:element name="NazwaPodmiotu" type="TNazwaPodmiotu"/>
			<xsd:element name="FormaOrganizacyjna" type="TFormaOrganizacyjna" minOccurs="0"/>
			<xsd:element name="AdresPodmiotu" type="TAdresUproszczony" minOccurs="0"/>
			<xsd:choice minOccurs="0">
				<xsd:element name="PodmiotNIP" type="TNIP" minOccurs="0"/>
				<xsd:sequence minOccurs="0">
					<xsd:element name="NumerWRejestrze" type="TNumerRejestru" minOccurs="0"/>
					<xsd:element name="DataRejestracji" type="TDataUrodzenia" minOccurs="0"/>
					<xsd:element name="NazwaRejestru" type="TNazwaRejestru" minOccurs="0"/>
					<xsd:element name="Kraj" type="TAdresKraj" minOccurs="0"/>
				</xsd:sequence>
			</xsd:choice>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TOsobaPrawna">
		<xsd:sequence>
			<xsd:element name="NazwaPodmiotu" type="TNazwaPodmiotu"/>
			<xsd:element name="FormaOrganizacyjna" type="TFormaOrganizacyjna"/>
			<xsd:element name="AdresPodmiotu" type="TAdres"/>
			<xsd:choice>
				<xsd:element name="PodmiotNIP" type="TNIP"/>
				<xsd:sequence>
					<xsd:element name="NumerWRejestrze" type="TNumerRejestru"/>
					<xsd:element name="DataRejestracji" type="TDataUrodzenia"/>
					<xsd:element name="NazwaRejestru" type="TNazwaRejestru"/>
					<xsd:element name="Kraj" type="TAdresKraj"/>
				</xsd:sequence>
			</xsd:choice>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TOsFizycznaUproszczona">
		<xsd:sequence>
			<xsd:element name="ImiePierwsze" type="TImie"/>
			<xsd:element name="ImieDrugie" type="TImie" minOccurs="0"/>
			<xsd:element name="Nazwisko" type="TNazwaPodmiotu"/>
			<xsd:element name="Obywatelstwo" type="TObywatelstwo"/>
			<xsd:choice minOccurs="0">
				<xsd:element name="PESEL" type="TPESEL" minOccurs="0"/>
				<xsd:sequence minOccurs="0">
					<xsd:element name="DataUrodzenia" type="TDataUrodzenia" minOccurs="0"/>
					<xsd:element name="KrajUrodzenia" type="TAdresKraj" minOccurs="0">
						<xsd:annotation>
							<xsd:documentation>Kod kraju urodzenia podmiotu</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:choice>
			<xsd:element name="DokumentTozsamosci" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="RodzajDokumentu" type="TRodzajDokumentu"/>
						<xsd:element name="SeriaINumerDokumentu" type="TSeriaINumerDokumentu">
							<xsd:annotation>
								<xsd:documentation>Dopuszczalne wszystkie znaki oprócz znaku końca linii. Nie dotyczy polskiego numeru dowodu osobistego i paszportu - wówczas dozwolone znaki to [A-Z0-9]*</xsd:documentation>
							</xsd:annotation>
						</xsd:element>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="AdresZamieszkania" type="TAdresUproszczony" minOccurs="0"/>
			<xsd:element name="DzialalnoscGosp" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:annotation>
							<xsd:documentation>pole należy wypełnic jeśli klient lub nie klient prowadzi dzialalność gospodarcza a Instytucja posiada dane</xsd:documentation>
						</xsd:annotation>
						<xsd:element name="NazwaFirmy" type="xsd:string"/>
						<xsd:element name="NIP" type="TNIP" minOccurs="0"/>
						<xsd:element name="Adres" type="TAdresUproszczony" minOccurs="0"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="KrajUrodzeniaOsoby" type="TAdresKraj" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TOsobaFizyczna">
		<xsd:sequence>
			<xsd:element name="ImiePierwsze" type="TImie"/>
			<xsd:element name="ImieDrugie" type="TImie" minOccurs="0"/>
			<xsd:element name="Nazwisko" type="TNazwisko"/>
			<xsd:element name="Obywatelstwo" type="TObywatelstwo"/>
			<xsd:choice>
				<xsd:element name="PESEL" type="TPESEL"/>
				<xsd:sequence>
					<xsd:element name="DataUrodzenia" type="TDataUrodzenia"/>
					<xsd:element name="KrajUrodzenia" type="TAdresKraj">
						<xsd:annotation>
							<xsd:documentation>Kod kraju urodzenia podmiotu</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:choice>
			<xsd:element name="DokumentTozsamosci">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:element name="RodzajDokumentu" type="TRodzajDokumentu"/>
						<xsd:element name="SeriaINumerDokumentu" type="TSeriaINumerDokumentu">
							<xsd:annotation>
								<xsd:documentation>Dopuszczalne wszystkie znaki oprócz znaku końca linii. Nie dotyczy polskiego numeru dowodu osobistego i paszportu - wówczas dozwolone znaki to [A-Z0-9]*</xsd:documentation>
							</xsd:annotation>
						</xsd:element>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="AdresZamieszkania" type="TAdres" minOccurs="0"/>
			<xsd:element name="DzialalnoscGosp" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:annotation>
							<xsd:documentation>pole należy wypełnic jeśli klient lub nie klient prowadzi dzialalność gospodarcza a Instytucja posiada dane</xsd:documentation>
						</xsd:annotation>
						<xsd:element name="NazwaFirmy" type="TNazwaPodmiotu"/>
						<xsd:element name="NIP" type="TNIP"/>
						<xsd:element name="Adres" type="TAdres"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="KrajUrodzeniaOsoby" type="TAdresKraj" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TNotarialnaDokumentTozsamosci">
		<xsd:sequence>
			<xsd:element name="KrajDokumentu" type="TAdresKraj">
				<xsd:annotation>
					<xsd:documentation>Kod państwa, które wydało dokument tożsamości.</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="RodzajDokumentu" type="TRodzajDokumentu"/>
			<xsd:element name="SeriaINumerDokumentu" type="TSeriaINumerDokumentu">
				<xsd:annotation>
					<xsd:documentation>Dopuszczalne wszystkie znaki oprócz znaku końca linii. Nie dotyczy polskiego numeru dowodu osobistego i paszportu - wówczas dozwolone znaki to [A-Z0-9]*</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TNotarialnaOsobaFizyczna">
		<xsd:sequence>
			<xsd:element name="ImiePierwsze" type="TImie"/>
			<xsd:element name="ImieDrugie" type="TImie" minOccurs="0"/>
			<xsd:element name="Nazwisko" type="TNazwisko"/>
			<xsd:element name="Obywatelstwo" type="TObywatelstwo"/>
			<xsd:choice>
				<xsd:element name="PESEL" type="TPESEL"/>
				<xsd:sequence>
					<xsd:element name="DataUrodzenia" type="TDataUrodzenia"/>
					<xsd:element name="KrajUrodzenia" type="TAdresKraj">
						<xsd:annotation>
							<xsd:documentation>Kod kraju urodzenia podmiotu</xsd:documentation>
						</xsd:annotation>
					</xsd:element>
				</xsd:sequence>
			</xsd:choice>
			<xsd:element name="DokumentTozsamosci" type="TNotarialnaDokumentTozsamosci"/>
			<xsd:element name="AdresZamieszkania" type="TAdres" minOccurs="0"/>
			<xsd:element name="DzialalnoscGosp" minOccurs="0">
				<xsd:complexType>
					<xsd:sequence>
						<xsd:annotation>
							<xsd:documentation>pole należy wypełnic jeśli klient lub nie klient prowadzi dzialalność gospodarcza a Instytucja posiada dane</xsd:documentation>
						</xsd:annotation>
						<xsd:element name="NazwaFirmy" type="TNazwaPodmiotu"/>
						<xsd:element name="NIP" type="TNIP"/>
						<xsd:element name="Adres" type="TAdres"/>
					</xsd:sequence>
				</xsd:complexType>
			</xsd:element>
			<xsd:element name="KrajUrodzeniaOsoby" type="TAdresKraj" minOccurs="0"/>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="TNumerRachunku">
		<xsd:choice>
			<xsd:element name="IBAN" type="TIBAN"/>
			<xsd:sequence>
				<xsd:element name="Kraj" type="TAdresKraj"/>
				<xsd:element name="NumerRachunku">
					<xsd:simpleType>
						<xsd:restriction base="xsd:string">
							<xsd:maxLength value="50"/>
							<xsd:pattern value="[A-Z0-9\.\-/]*"/>
						</xsd:restriction>
					</xsd:simpleType>
				</xsd:element>
			</xsd:sequence>
		</xsd:choice>
	</xsd:complexType>
	<xsd:complexType name="TDaneSkonsolidowane">
		<xsd:sequence>
			<xsd:element name="Nazwa">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="300"/>
						<xsd:pattern value=".*"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="DaneAdresowe">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="300"/>
						<xsd:pattern value=".*"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="TAdresKraj">
		<xsd:restriction base="xsd:string">
			<xsd:length value="2"/>
			<xsd:pattern value="[A-Z0-9]{2}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TAdresKodPL">
		<xsd:restriction base="xsd:string">
			<xsd:length value="6"/>
			<xsd:pattern value="[0-9]{2}-[0-9]{3}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TAdresKod">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="25"/>
			<xsd:pattern value=".*"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TNazwaPodmiotu">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="512"/>
			<xsd:pattern value=".*"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TAdresMiejscowosc">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="35"/>
			<xsd:pattern value=".*"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TAdresUlica">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="80"/>
			<xsd:pattern value=".*"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TImie">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="30"/>
			<xsd:pattern value=".*"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TNazwisko">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="40"/>
			<xsd:pattern value=".*"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TObywatelstwo">
		<xsd:restriction base="xsd:string">
			<xsd:length value="2"/>
			<xsd:pattern value="[A-Z]{2}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TDataTr">
		<xsd:restriction base="xsd:dateTime"/>
	</xsd:simpleType>
	<xsd:simpleType name="TDataUrodzenia">
		<xsd:restriction base="xsd:date"/>
	</xsd:simpleType>
	<xsd:simpleType name="TPESEL">
		<xsd:restriction base="xsd:string">
			<xsd:length value="11"/>
			<xsd:pattern value="\d{11}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TNIP">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="10"/>
			<xsd:pattern value="[0-9]{10}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TRodzajDokumentu">
		<xsd:restriction base="xsd:string">
			<xsd:length value="2"/>
			<xsd:pattern value="[A-Z]{2}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TSeriaINumerDokumentu">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="40"/>
			<xsd:pattern value=".*"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TNazwaRejestru">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="40"/>
			<xsd:pattern value=".*"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TFormaOrganizacyjna">
		<xsd:restriction base="xsd:string">
			<xsd:length value="2"/>
			<xsd:pattern value="[A-Z0-9]{2}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TIBAN">
		<xsd:restriction base="xsd:string">
			<xsd:maxLength value="34"/>
			<xsd:pattern value="[A-Z]{2}[0-9]{2}[A-Z0-9]{1,30}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodWalutyTr">
		<xsd:restriction base="xsd:string">
			<xsd:length value="3"/>
			<xsd:pattern value="[A-Z]{3}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKodRodzTr">
		<xsd:restriction base="xsd:string">
			<xsd:length value="2"/>
			<xsd:pattern value="[0-9]{2}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TKwotaTr">
		<xsd:restriction base="xsd:decimal">
			<xsd:minInclusive value="0"/>
			<xsd:totalDigits value="20"/>
			<xsd:fractionDigits value="2"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TSposobWydaniaDyspTr">
		<xsd:restriction base="xsd:string">
			<xsd:length value="1"/>
			<xsd:pattern value="[0-9]{1}"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="TGminaID">
		<xsd:restriction base="xsd:string">
