# Do obrazu NIGDY nie trafiaja dane kancelarii ani sekrety.
dane/
.env
.env.*
!.env.example

# Srodowisko i cache
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# Narzedzia deweloperskie i pliki stanowiska lokalnego
.git/
.gitignore
.claude/
*.bat
*.log
*.tmp
*.bak
.vscode/
.idea/

# Rzeczy spoza dzialania aplikacji (obraz byl przez nie o ok. 80 MB wiekszy).
# Z docs/ aplikacja czyta tylko docs/prawne (dokumenty_prawne.py).
docs/*
!docs/prawne
marketing/
tools/
scripts/
probki/
tests/
test_*.py
conftest.py
pytest.ini
infra/
.github/
